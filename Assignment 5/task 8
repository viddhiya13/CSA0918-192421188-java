import java.sql.*;
import java.util.*;

public class PassLoader {

    public static int loadAll(Connection con, List<String[]> passes)
            throws SQLException {

        String sql = "INSERT INTO bus_pass(pass_id, reg_no, name, route_no, amount) " +
                "VALUES (?, ?, ?, ?, ?)";

        boolean oldAutoCommit = con.getAutoCommit();
        con.setAutoCommit(false);

        int count = 0;

        try (PreparedStatement ps = con.prepareStatement(sql)) {

            for (String[] p : passes) {

                ps.setString(1, p[0]);
                ps.setString(2, p[1]);
                ps.setString(3, p[2]);
                ps.setInt(4, Integer.parseInt(p[3]));
                ps.setDouble(5, Double.parseDouble(p[4]));

                ps.addBatch();
                count++;

                if (count % 1000 == 0) {
                    ps.executeBatch();
                }
            }

            ps.executeBatch();
            con.commit();

            return count;

        } catch (SQLException | RuntimeException e) {
            con.rollback();
            throw e;

        } finally {
            con.setAutoCommit(oldAutoCommit);
        }
    }

    public static void main(String[] args) throws Exception {

        String url = "jdbc:mysql://localhost:3306/campus_event";
        String user = "root";
        String password = "your_password";

        List<String[]> passes = new ArrayList<>();

        for (int i = 1; i <= 1000; i++) {
            passes.add(new String[]{
                    "P" + i,
                    "REG" + i,
                    "Student" + i,
                    String.valueOf(i % 20 + 1),
                    "4500.0"
            });
        }

        try (Connection con =
                     DriverManager.getConnection(url, user, password)) {

            long start = System.nanoTime();

            int result = loadAll(con, passes);

            long end = System.nanoTime();

            System.out.println("Records inserted: " + result);

            System.out.println("Time taken: " +
                    (end - start) / 1_000_000.0 + " ms");
        }
    }
}
