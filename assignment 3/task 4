
class ScannerThread extends Thread {

    private int scripts;

    ScannerThread(String name, int scripts) {
        super(name);
        this.scripts = scripts;
    }

    public void run() {
        try {
            System.out.println(getName() + " started scanning");

            Thread.sleep(1000);

            System.out.println(getName() +
                    " scanned " + scripts + " scripts");

        } catch (InterruptedException e) {
            System.out.println("Thread interrupted");
            Thread.currentThread().interrupt();
        }
    }
}

class RunnableStation implements Runnable {

    private int scripts;

    RunnableStation(int scripts) {
        this.scripts = scripts;
    }

    public void run() {
        try {
            System.out.println(Thread.currentThread().getName()
                    + " started scanning");

            Thread.sleep(1500);

            System.out.println(Thread.currentThread().getName()
                    + " scanned " + scripts + " scripts");

        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
    }
}

public class ScannerStations {

    public static void main(String[] args)
            throws InterruptedException {

        ScannerThread s1 = new ScannerThread("Station 1", 20);
        ScannerThread s2 = new ScannerThread("Station 2", 25);

        Thread s3 = new Thread(new RunnableStation(30),
                "Station 3");

        Thread s4 = new Thread(new RunnableStation(25),
                "Station 4");

        s1.start();
        s2.start();
        s3.start();
        s4.start();

        System.out.println("Station 1 alive: " + s1.isAlive());

        s1.join();
        s2.join();
        s3.join();
        s4.join();

        System.out.println("All stations completed.");
        System.out.println("Total scripts scanned: 100");
    }
}
