
public class SeatBooking {

    private final boolean[] booked;
    private int bookingsMade = 0;

    SeatBooking(int seats) {
        booked = new boolean[seats];
    }

    // Without synchronization
    public void unsafeBook(int seat) {

        if (!booked[seat]) {

            try {
                Thread.sleep(10);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                return;
            }

            booked[seat] = true;
            bookingsMade++;

            System.out.println("Seat " + seat + " booked");
        }
    }

    // With synchronization
    public synchronized void book(int seat) {

        if (!booked[seat]) {

            booked[seat] = true;
            bookingsMade++;

            System.out.println("Seat " + seat + " booked");
        }
    }

    public static void main(String[] args)
            throws InterruptedException {

        SeatBooking screen = new SeatBooking(10);

        Thread[] users = new Thread[100];

        // Change this to false to test unsafe booking
        boolean useSynchronization = true;

        for (int i = 0; i < users.length; i++) {

            final int seat = i % 10;

            if (useSynchronization) {
                users[i] = new Thread(() -> screen.book(seat));
            } else {
                users[i] = new Thread(() -> screen.unsafeBook(seat));
            }

            users[i].start();
        }

        for (Thread t : users) {
            t.join();
        }

        System.out.println("Seats sold: " + screen.bookingsMade);
    }
}
