
import java.io.*;

public class SalesReport {

    // Manual resource closing
    static void manualVersion() {

        BufferedReader reader = null;
        BufferedWriter writer = null;

        try {
            reader = new BufferedReader(new FileReader("sales1.txt"));
            writer = new BufferedWriter(new FileWriter("manual_report.txt"));

            String line;

            while ((line = reader.readLine()) != null) {
                writer.write(line);
                writer.newLine();
            }

            System.out.println("Manual report generated.");

        } catch (IOException e) {
            System.out.println("Manual Error: " + e.getMessage());

        } finally {

            try {
                if (reader != null)
                    reader.close();

                if (writer != null)
                    writer.close();

            } catch (IOException e) {
                System.out.println("Closing Error: " + e.getMessage());
            }
        }
    }

    // Automatic resource closing
    static void automaticVersion() {

        try (
            BufferedReader reader =
                new BufferedReader(new FileReader("sales1.txt"));

            BufferedWriter writer =
                new BufferedWriter(new FileWriter("automatic_report.txt"))
        ) {

            String line;

            while ((line = reader.readLine()) != null) {
                writer.write(line);
                writer.newLine();
            }

            System.out.println("Automatic report generated.");

        } catch (IOException e) {
            System.out.println("Automatic Error: " + e.getMessage());
        }
    }

    public static void main(String[] args) {

        manualVersion();

        automaticVersion();
    }
}
